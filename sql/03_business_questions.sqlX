-- =========================================================
-- Step 3: Business questions answered with SQL
-- =========================================================
USE superstore;

-- Q1. Which sub-categories generate lots of revenue but are actually
--     losing money? (classic "growth trap" question every retailer asks)
SELECT
    category,
    sub_category,
    SUM(sales)                                   AS total_sales,
    SUM(profit)                                  AS total_profit,
    ROUND(SUM(profit) / NULLIF(SUM(sales),0) * 100, 1) AS profit_margin_pct
FROM orders
GROUP BY category, sub_category
ORDER BY total_sales DESC;


-- Q2. Which region + category combinations are net unprofitable?
--     (tells leadership exactly where to cut or renegotiate, not just "sales are down")
SELECT
    region,
    category,
    SUM(sales)   AS total_sales,
    SUM(profit)  AS total_profit
FROM orders
GROUP BY region, category
HAVING SUM(profit) < 0
ORDER BY total_profit ASC;


-- Q3. Is discounting killing margin? Bucket orders by discount tier
--     and compare average profit margin per tier.
SELECT
    CASE
        WHEN discount = 0            THEN '0% (no discount)'
        WHEN discount <= 0.15        THEN '1-15%'
        WHEN discount <= 0.30        THEN '16-30%'
        ELSE '31%+'
    END AS discount_tier,
    COUNT(*)                                      AS num_orders,
    SUM(sales)                                    AS total_sales,
    SUM(profit)                                   AS total_profit,
    ROUND(SUM(profit) / NULLIF(SUM(sales),0) * 100, 1) AS profit_margin_pct
FROM orders
GROUP BY discount_tier
ORDER BY MIN(discount);

-- Q4. Top 10 customers by profit contribution (who are we actually
--     making money from, vs. who just generates order volume?)
SELECT
    customer_id,
    customer_name,
    COUNT(DISTINCT order_id) AS num_orders,
    SUM(sales)               AS total_sales,
    SUM(profit)              AS total_profit
FROM orders
GROUP BY customer_id, customer_name
ORDER BY total_profit DESC
LIMIT 10;


-- Q5. Average delivery time (days) by ship mode -- are we over-promising
--     on "Same Day" / "First Class" shipping?
SELECT
    ship_mode,
    COUNT(*)                                       AS num_orders,
    ROUND(AVG(DATEDIFF(ship_date, order_date)), 1) AS avg_days_to_ship
FROM orders
GROUP BY ship_mode
ORDER BY avg_days_to_ship;


-- Q6. Monthly sales & profit trend (seasonality check for the dashboard's
--     main trend line)
SELECT
    DATE_FORMAT(order_date, '%Y-%m') AS year_month,
    SUM(sales)                       AS total_sales,
    SUM(profit)                      AS total_profit
FROM orders
GROUP BY year_month
ORDER BY year_month;

-- Q7. Which states are net loss-makers despite having real sales volume?
--     (a state can look "fine" on total sales while quietly losing money)
SELECT
    state,
    region,
    SUM(sales)  AS total_sales,
    SUM(profit) AS total_profit
FROM orders
GROUP BY state, region
HAVING SUM(profit) < 0
ORDER BY total_profit ASC;


-- Q8. Profitability by customer segment (Consumer vs Corporate vs Home Office)
SELECT
    segment,
    SUM(sales)                                    AS total_sales,
    SUM(profit)                                   AS total_profit,
    ROUND(SUM(profit) / NULLIF(SUM(sales),0) * 100, 1) AS profit_margin_pct,
    COUNT(DISTINCT customer_id)                   AS num_customers
FROM orders
GROUP BY segment
ORDER BY total_profit DESC;
